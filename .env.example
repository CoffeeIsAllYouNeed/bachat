# Copy to .env (git-ignored) and fill in what you use. Restart `npx expo start` after a change.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone who has it:
# never put a secret here that you would not publish.

# --- AI (pick one) ---------------------------------------------------------
# Recommended: your AI proxy (worker/ — a Cloudflare Worker that keeps the Gemini key server-side).
EXPO_PUBLIC_AI_PROXY_URL=
# Optional shared token the proxy checks (x-app-token). Slows down casual abuse; it is not a secret.
EXPO_PUBLIC_AI_APP_TOKEN=

# Development only: call Gemini directly with your own key (ignored when the proxy URL is set).
# Key from https://aistudio.google.com/apikey — do not ship a build with this filled in.
EXPO_PUBLIC_GEMINI_API_KEY=
# First model to try (fallbacks follow automatically).
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest

# --- Family sync (optional) ------------------------------------------------
# Supabase project URL and anon key (public by design; Row Level Security protects the data,
# and snapshots are end-to-end encrypted). Leave empty for local/demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
